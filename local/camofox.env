# camofox-browser environment configuration
#
# Source this before starting the server or running the MCP proxy.
# Windows: source with the helper in camofox-ctl.ps1 or set manually.
#
# This file uses a bash-compatible format that camofox-ctl.ps1 parses.
# On Windows, edit the default values below to match your setup.

# === Repository ===
# Path to the camofox-browser repo root. Leave as-is if running from there.
# Windows: use forward slashes or $env:USERPROFILE
# REPO=/home/adeliktas/gitrepos/securityrepos/camofox-browser
REPO=${REPO:-$HOME/gitrepos/securityrepos/camofox-browser}

# === Server ===
# Port the REST API listens on. Default 9377 for Docker, 8788 for local dev.
CAMOFOX_PORT=${CAMOFOX_PORT:-9377}
CAMOFOX_BIND_HOST=${CAMOFOX_BIND_HOST:-127.0.0.1}

# Disable crash reports (browser generates core dumps that fill disk)
CAMOFOX_CRASH_REPORT_ENABLED=false

# === Browser Mode ===
# 'off' = headless (default, best for MCP/agents)
# 'desktop' = visible window (for manual use)
CAMOFOX_INTERACTIVE=${CAMOFOX_INTERACTIVE:-off}

# === Directories ===
# User profile, cookies, state — all relative to $HOME or your Windows profile
# Windows: replace with actual paths, e.g.:
#   CAMOFOX_PROFILE_DIR=%USERPROFILE%\.local\share\camofox-browser\profiles
CAMOFOX_PROFILE_DIR=${CAMOFOX_PROFILE_DIR:-%USERPROFILE%\.local\share\camofox-browser\profiles}
CAMOFOX_COOKIES_DIR=${CAMOFOX_COOKIES_DIR:-%USERPROFILE%\.local\share\camofox-browser\cookies}
CAMOFOX_TRACES_DIR=${CAMOFOX_TRACES_DIR:-%USERPROFILE%\.local\share\camofox-browser\traces}
CAMOFOX_UPLOADS_DIR=${CAMOFOX_UPLOADS_DIR:-%USERPROFILE%\.local\share\camofox-browser\uploads}
CAMOFOX_STATE_DIR=${CAMOFOX_STATE_DIR:-%USERPROFILE%\.local\share\camofox-browser}

# === MCP Identity ===
# Stable identity per agent. The MCP proxy hashes a random UUID per process
# by default, giving every agent session its own cookies. Set one user ID
# so all agent sessions share cookies/sessions.
CAMOFOX_USER_ID=${CAMOFOX_USER_ID:-default}
